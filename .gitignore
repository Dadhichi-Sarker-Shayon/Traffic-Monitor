# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/

# Virtual environments — rebuilt on local disk in D:\envs, never commit
.venv/
.venv-infer/

# Model weights: auto-downloaded (YOLO) or SHA-verified separately (PSGTR
# checkpoint lives in third_party/openpsg/work_dirs/checkpoints/ inside the
# submodule and is not tracked here)
*.pt
*.pth

# Legacy empty stub dirs at repo root; real outputs live in
# realtime-video-tracking/outputs/
/outputs/

# Eval set: the contact sheets and sampled copies are regenerable from the
# clips with tools/make_eval_set.py, so only the labels and report are tracked.
# ** matters: a pattern with a slash is anchored to this directory.
**/eval/sheets/
**/eval/samples/

# Editors / OS
.idea/
.vscode/
Thumbs.db

# Local scratch and archived experiments - never commit
_archive/
**/runs/

# Test outputs and downloaded footage: only the curated demo outputs are tracked
**/outputs/test_*
**/sample_media/clips/yt_*

# Other projects that live in this folder but are not part of this repository
/image-scene-search/
/media-scene-search/
/scene-graph-captioner/
/video-scene-graphs/
/scripts/
/sample_media/
